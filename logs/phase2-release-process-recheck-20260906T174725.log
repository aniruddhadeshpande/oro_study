# command: bash -c curl -fsSL https://doc.oroinc.com/community/release-process/ | python3 -c "
import sys,re,html
t=sys.stdin.read()
t=re.sub(r\"(?s)<(script|style).*?</\1>\",\" \",t)
t=re.sub(r\"<[^>]+>\",\" \",t)
t=html.unescape(t)
t=re.sub(r\"[ \t]+\",\" \",t)
t=re.sub(r\"\n\s*\n+\",\"\n\",t)
print(t)
"


