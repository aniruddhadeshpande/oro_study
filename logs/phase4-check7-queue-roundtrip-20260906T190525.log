# command: bash -c cd docker
q() { docker compose exec -T db psql -U orodbuser -d orodb -tAc "select count(*) from oro_message_queue;" | tr -d "[:space:]"; }
echo "== consumer state before restart =="; docker compose ps -a --format "{{.Service}} {{.State}}" | grep consumer
echo "== depth with consumer DOWN: $(q) =="
START=$(date +%s)
echo "== starting consumer =="; docker compose start consumer >/dev/null 2>&1
docker compose ps --format "{{.Service}} {{.State}}" | grep consumer
for i in $(seq 1 30); do
  D=$(q); NOW=$(date +%s); EL=$((NOW-START))
  echo "t+${EL}s depth=$D"
  if [ "$D" = "0" ]; then echo "== DRAINED at t+${EL}s =="; break; fi
  sleep 5
done

